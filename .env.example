# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ownthedigital?retryWrites=true&w=majority

# Auth
AUTH_SECRET=your_auth_secret_key
ADMIN_SESSION_COOKIE=otd_admin_session

# Cloudinary Configuration (Required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=ownthedigital/blogs

# Public Website URL (for previewing live articles from admin dashboard)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
